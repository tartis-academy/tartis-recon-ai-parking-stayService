# Variables del Postgres dedicado de stay-service.
# cp .env.example .env && docker compose up -d

STAY_DB_NAME=stay_db
STAY_DB_USER=stay_user
STAY_DB_PASSWORD=change.me

# Puerto en el HOST. vehicle 5433, spot 5434, tariff 5435, ticket 5436, stay 5437.
STAY_DB_PORT=5437
# RabbitMQ (ASY-02/ASY-03). Broker unico compartido; ticket-service y
# spot-service apuntaran a este mismo host/puerto para consumir.
RABBITMQ_USER=parking_dev
RABBITMQ_PASSWORD=change.me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672